HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
HAILUO_CREATE_URL=https://hailuoai.com/create/image-to-video

# 海螺流量（hailuoai.com 的签名 API + Playwright 浏览器）从哪个出口走，三选一：
#   iproyal  用下面 HAILUO_PROXY_URL 里的住宅代理
#   local    用本机的代理客户端（HAILUO_LOCAL_PROXY_URL，默认 Clash/mihomo 的 127.0.0.1:7897）
#   direct   不走代理
# 留空时：填了 HAILUO_PROXY_URL 就是 iproyal，否则 direct。
# 这些请求都带账号 _token，必须同一出口 IP，否则海螺风控会看到一个账号在跨国跳，
# 所以 API 和浏览器共用这一个开关，不要分开配。
# 其余出网一律直连，特别是 Aliyun OSS 的参考图上传：那是几 MB 的 PUT，走住宅代理会在
# ~67 秒后被断开（undici UND_ERR_SOCKET）；它用 STS 签名、不带 token，直连没有暴露面。
# 不要设 HTTPS_PROXY / HTTP_PROXY / NO_PROXY，进程不读全局代理环境变量。
HAILUO_PROXY=
HAILUO_PROXY_URL=
HAILUO_LOCAL_PROXY_URL=http://127.0.0.1:7897

# 怎么调海螺，和上面"从哪个出口走"是两个独立的开关：
#   api      自己签名、从 Node 发请求（现状）
#   browser  在 Playwright 页面里调网页自己的 axios，签名/设备/指纹都由海螺前端代码生成
#            （方案见 docs/browser-injected-api.md，尚未接入，选它会在启动时报错）
HAILUO_TRANSPORT=api

# 本服务 /v1/* 的网关密钥，调用方放在 x-api-key 头里。与海螺无关。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEY=

# 海螺账号凭证放在文本文件里，默认为项目根目录的 tokens.txt。
# 文件内一行一个 _token，依次对应 hailuo-1、hailuo-2……
HAILUO_TOKEN_FILE=./tokens.txt

# 生成视频的默认参数（每个 job 都可以在 options 里覆盖）
# MiniMax H3：768p=7积分/秒，2K(1440)=12积分/秒，支持4-15秒
HAILUO_MODEL_ID=hailuo3.0-i2v
HAILUO_RESOLUTION=768
HAILUO_DURATION=5
HAILUO_ASPECT_RATIO=16:9
HAILUO_REFERENCE_MODE=all-reference
HAILUO_FRAME_TYPE=4
HAILUO_POLL_TIMEOUT_MS=900000
HAILUO_POLL_INTERVAL_MS=10000
# 单个步骤（读余额 / 上传参考图 / 提交 / 轮询 / 海螺渲染失败重投）失败后的重试间隔，
# 逗号分隔，个数即重试次数。默认 10s/30s/60s 共 3 次；写 none 关闭重试。
# 除账号积分不足（由调度器换号）和文案违规（改文案再提）外，任何失败都重试：网络抖动、
# 资源较忙、渲染失败重投、token 异常、未知错误。渲染超时的重试是继续轮询同一条视频，不重投。
HAILUO_RETRY_DELAYS_MS=10000,30000,60000

# 渠道：Higgsfield（higgsfield.ai）。纯 API，不用浏览器；细节见 docs/higgsfield.md。
HIGGSFIELD_ORIGIN=https://fnf-api-gw.higgsfield.ai/fnf
# 认证走 Clerk：账号文件里存长效的 __client cookie，网关要的 __session JWT 只活约 60 秒，
# 由本服务在这个 Clerk 域上现换、用完即弃。
HIGGSFIELD_CLERK_ORIGIN=https://clerk.higgsfield.ai
HIGGSFIELD_ACCOUNT_FILE=./higgsfield-accounts.txt
# 默认直连；设了才走代理，覆盖网关与 Clerk，预签名的图片直传始终直连。
HIGGSFIELD_PROXY_URL=

# 生成器（/jobs/ 后面那一段）与它跑的版本。任务里用 options.modelId 覆盖，
# 写 "生成器:模型" 可以一次指定两层，例如 seedance:seedance-2-5。
HIGGSFIELD_JOB_TYPE=seedance
HIGGSFIELD_MODEL=
HIGGSFIELD_RESOLUTION=720p
HIGGSFIELD_DURATION=5
HIGGSFIELD_ASPECT_RATIO=16:9
# 参考素材挂在 params 的哪个键上：medias（较新的生成器，收图/视频/音频三种）
# 或 input_image（image2video、minimax-hailuo、kling，只收两张图）。
# 平台不告诉你哪个生成器要哪一套，写错不会报错，只会出一条看不见参考素材的视频。
# 按任务可用 options.mode 覆盖。（注意网关的 /v1/assets 目前只收图片。）
HIGGSFIELD_IMAGE_BINDING=medias
HIGGSFIELD_POLL_TIMEOUT_MS=900000
HIGGSFIELD_POLL_INTERVAL_MS=10000
HIGGSFIELD_RETRY_DELAYS_MS=10000,30000,60000

# 渠道：Miora（miora.design）。纯 API，不用浏览器；细节见 docs/miora.md。
# 账号是一对令牌：authToken（JWT，约 15 天）+ refreshToken（def50200…，用来自动续期）。
# 账号文件里一行一个 JSON：{"authToken":"eyJ…","refreshToken":"def50200…"}。
MIORA_ACCOUNT_FILE=./miora-accounts.txt
# 浏览器导出的 miora.design site-state JSON 丢进这个目录：网关运行中自动导入（按账号去重，只用更新的令牌覆盖）；
# 也可手动 `npm run miora:import` 导入这个目录。
MIORA_IMPORT_DIR=./miora-imports
# 默认请求直连；代理仅用于生成提交和任务进度查询，上传凭证、COS 上传、余额、续期等始终直连。
# 留空 = 提交和任务查询默认走下面的本地代理，失败再直连。
MIORA_PROXY_URL=
# 可选：本机 DNS 错误时填经核实的代理网关 IPv4/IPv6；网关变更后需更新或清空。
MIORA_PROXY_ADDRESS=
# auto 自动跟随 Windows 当前启用的系统代理，切换软件/端口无需重启；也可填固定 HTTP 代理 URL。
MIORA_LOCAL_PROXY_URL=auto
# 只接了 minimax-h3（全能参考，多模态：图/视频/音频参考）。任务里用 options 覆盖。
# 分辨率 768P / 2K；时长 4-15 秒；参考图最多 9、参考视频/音频各 3。
MIORA_MODEL=minimax-h3
MIORA_RESOLUTION=768P
MIORA_DURATION=5
MIORA_ASPECT_RATIO=16:9
MIORA_POLL_TIMEOUT_MS=900000
MIORA_POLL_INTERVAL_MS=5000
MIORA_RETRY_DELAYS_MS=10000,30000,60000
# 多久检查一次 authToken 是否临近过期（有 refreshToken 的会自动续期）。
MIORA_TOKEN_CHECK_MS=3600000

BROWSER_POOL_SIZE=2
BROWSER_HEADLESS=true
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers
MAX_UPLOAD_BYTES=10485760
DATA_DIR=./data
JOB_TIMEOUT_MS=120000

# 独立系统账户服务（不会初始化渠道、浏览器或生成器）。本地：pnpm system:dev。
# 生产必须 HTTPS，同域 /admin 与 /api/*；NODE_ENV=production 强制安全 Cookie 与限流。
# 反代信任列表由部署显式设置；本模块不默认信任转发头。
SYSTEM_HOST=127.0.0.1
SYSTEM_PORT=3001
SYSTEM_BASE_URL=http://127.0.0.1:3001
SYSTEM_DATABASE_PATH=./data/system.sqlite
# 至少32字符，部署生成并保密；示例无默认密钥。
SYSTEM_AUTH_SECRET=
# 逗号分隔精确origin（可留空，仅允许SYSTEM_BASE_URL），不得通配符。
SYSTEM_TRUSTED_ORIGINS=
# 测试从代码注入MemorySystemMailer；正常服务仅smtp，不把验证链接写日志。
SYSTEM_MAIL_MODE=smtp
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_FROM=
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
# 共享资格默认关闭，激活与共享资格独立。到期本地限制政策待定。
# 管理员无公开注册接口。部署首超管需先邮箱验证，再显式离线CLI grant现有账户（见src/system/README.md）。
# 以下是独立fixture模式，仅新建/tmp测试库 + .test/.invalid邮箱，不能写现有/生产库。
# SYSTEM_BOOTSTRAP_LOCAL_TEST=1
# SYSTEM_BOOTSTRAP_TEST_DATABASE=/tmp/aistudio-local-test/system.sqlite
# SYSTEM_BOOTSTRAP_TEST_EMAIL=admin@example.invalid
# SYSTEM_BOOTSTRAP_TEST_PASSWORD=（至少12字符，自行指定；不要使用生产凭据）

# 完整系统入口 pnpm system:dev / system:start；原start需SYSTEM_ENABLED=true才启用系统。
SYSTEM_ENABLED=false
# 默认身份/管理/共享独立启动，绝不启动旧渠道网络；明确开启才复用旧worker。
SYSTEM_CHANNELS_ENABLED=false
SYSTEM_ADMIN_DIRECTORY=./apps/admin/dist
SYSTEM_MEDIA_DIRECTORY=./data/private-media
# 仅可信代理IP/CIDR列表，默认不信任forwarded headers，禁止无边界true。
SYSTEM_TRUST_PROXY=
# 用户后续配置32byte随机key的base64；不提供默认密钥、不自动生成生产key。
CHANNEL_CREDENTIAL_KEY=
