NODE_ENV=production
SYSTEM_HOST=127.0.0.1
SYSTEM_PORT=3001
SYSTEM_BASE_URL=https://studio.crypto-compass-web.online
SYSTEM_DATABASE_PATH=/var/lib/aistudio-studio/system.sqlite
SYSTEM_MEDIA_DIRECTORY=/var/lib/aistudio-studio/private-media
SYSTEM_ADMIN_DIRECTORY=/www/server/aistudio-studio/current/apps/admin/dist
SYSTEM_AUTH_SECRET=REPLACE_WITH_SERVER_GENERATED_RANDOM_SECRET
SYSTEM_TRUST_PROXY=127.0.0.1,::1
SYSTEM_CHANNELS_ENABLED=false
# Enable explicitly with server/deploy/enable-video-gateway.py after deployment.
SYSTEM_VIDEO_GATEWAY_ENABLED=false
# Generated only by the explicit gateway migration; existing values are retained.
# API_KEY must contain at least 32 characters. CHANNEL_CREDENTIAL_KEY is base64 of 32 bytes.
API_KEY=
CHANNEL_CREDENTIAL_KEY=
# The online gateway requires an explicit server-side HTTP(S) Miora proxy.
# Set privately on the server or import through --proxy-env-file; never commit credentials.
MIORA_PROXY_URL=
# Optional verified proxy gateway IP address for DNS pinning.
MIORA_PROXY_ADDRESS=
# The gateway migration creates and owns these persistent paths for APP_USER.
DATA_DIR=/var/lib/aistudio-studio/gateway
HAILUO_TOKEN_FILE=/var/lib/aistudio-studio/gateway/tokens.txt
DREAMMAKER_ACCOUNT_FILE=/var/lib/aistudio-studio/gateway/dreammaker-accounts.txt
HIGGSFIELD_ACCOUNT_FILE=/var/lib/aistudio-studio/gateway/higgsfield-accounts.txt
MIORA_ACCOUNT_FILE=/var/lib/aistudio-studio/gateway/miora-accounts.txt
MIORA_IMPORT_DIR=/var/lib/aistudio-studio/gateway/miora-imports
SYSTEM_MAIL_MODE=smtp
SYSTEM_SMTP_HOST=smtp.qq.com
SYSTEM_SMTP_PORT=465
SYSTEM_SMTP_SECURE=true
SYSTEM_SMTP_FROM=REPLACE_WITH_QQ_EMAIL
SYSTEM_SMTP_USER=REPLACE_WITH_QQ_EMAIL
# QQ SMTP authorization code, not the QQ login password. Keep only on server.
SYSTEM_SMTP_PASSWORD=
