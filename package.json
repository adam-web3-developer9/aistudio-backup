{
  "name": "browser-automation-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "browser:install": "node scripts/install-browser.mjs",
    "higgsfield:login": "node --import tsx scripts/higgsfield-login.mjs",
    "higgsfield:browser": "node --import tsx scripts/higgsfield-browser.mjs",
    "higgsfield:mcp-login": "node --import tsx scripts/higgsfield-mcp-login.mjs",
    "miora:import": "node --import tsx scripts/miora-import.mjs",
    "miora:login": "node --import tsx scripts/miora-login.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "system:dev": "node --watch --env-file-if-exists=.env --import tsx src/system/server.ts",
    "system:start": "node --env-file-if-exists=.env dist/system/server.js",
    "system:bootstrap-local-test": "node --import tsx scripts/bootstrap-admin.mjs",
    "system:test": "vitest run src/system",
    "system:bootstrap-admin": "node --import tsx scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@volcengine/tos-sdk": "2.9.1",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.5.0",
    "nodemailer": "^10.1.0",
    "playwright": "^1.55.0",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0",
    "undici": "^8.10.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
